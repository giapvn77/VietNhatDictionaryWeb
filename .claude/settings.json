{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(./mvnw:*)",
      "Bash(git:*)",
      "Read(backend/**)",
      "Read(frontend/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo:*)",
      "Write(/etc/**)",
      "Write(/usr/**)"
    ]
  },
  "env": {
    "DB_HOST": "localhost",
    "DB_PORT": "1433",
    "DB_NAME": "vietnhat_dictionary",
    "DB_USER": "sa",
    "DB_ENCRYPT": "true",
    "DB_TRUST_CERT": "true"
  },
  "language": "vietnamese"
}
